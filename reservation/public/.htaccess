Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # 実在するファイル（CSSなど）はそのまま、それ以外は index.php へ
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# 万一 index.php 以外の PHP が置かれても実行させない
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>
