# このファイルをコピーして「.env」という名前にし、値を書き換える
#   cp .env.example .env
# .env は秘密情報を含むので Git にコミットしない（.gitignore 済み）

# development / production
APP_ENV=development

# htdocs/reservation に置いた場合 → /reservation
# VirtualHost で public/ を直接 DocumentRoot にした場合 → 空にする
APP_BASE_PATH=/reservation

# localhost 以外から HTTP で来たアクセスを拒否する（学内LANでは HTTPS 必須）
APP_REQUIRE_HTTPS_FOR_REMOTE=true

# localhost = XAMPP の MySQL にソケットで直接つなぐ（phpMyAdmin と同じ経路）
# 127.0.0.1 にすると、Macに別のMySQLが入っている場合そちらにつながってしまうことがある
DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_reservation
# root は使わない。database/setup/02_create_app_user.sql で作った専用ユーザー
DB_USER=rsv_app
DB_PASSWORD=
